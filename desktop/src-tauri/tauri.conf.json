{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rag-mtst",
  "version": "0.1.0",
  "identifier": "dev.ragmtst.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{"label":"main","title":"rag-mtst","width":1130,"height":760,"minWidth":760,"minHeight":560}],
    "security": {"csp":"default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"}
  },
  "bundle": { "active": true, "targets": ["deb","appimage"], "icon": ["icons/icon.png"] }
}
